# Advisor identity and tenancy.
# Every record is scoped to the signed-in advisor. In local development the app falls
# back to a single local advisor so it runs with no auth infrastructure.
# Set REQUIRE_ADVISOR_AUTH=1 in any deployment reachable by more than one person: it
# disables the fallback and refuses unauthenticated requests.
REQUIRE_ADVISOR_AUTH=
LOCAL_ADVISOR_EMAIL=local-advisor@localhost
# Rows created before tenancy existed are claimed by this advisor the first time the
# owner_id column is added. Set it to the real advisor's address BEFORE the first
# deploy that turns REQUIRE_ADVISOR_AUTH on, or those rows are claimed by the local
# fallback identity instead. Defaults to LOCAL_ADVISOR_EMAIL.
LEGACY_OWNER_EMAIL=

# Optional live integrations. The app works without these values.
OPENAI_API_KEY=
OPENAI_RESEARCH_MODEL=gpt-5.6-sol
FIREFLIES_API_KEY=
APOLLO_API_KEY=
PANDADOC_API_KEY=
PANDADOC_TEMPLATE_UUID=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# Google Workspace OAuth and the lightweight CRM destination.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEETS_ID=1ANLc7vhkhkJBtkvoeLDeuXJw4yIlCJcyz3j6B_69GX8
GOOGLE_DRIVE_ROOT_FOLDER_ID=
# Optional override for the transcript-synthesis model. Falls back to
# OPENAI_RESEARCH_MODEL. Uses the same OPENAI_API_KEY; with no key the app
# falls back to deterministic transcript synthesis and says so in the UI.
OPENAI_TRANSCRIPT_MODEL=
